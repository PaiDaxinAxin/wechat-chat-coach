{
  "name": "wechat-chat-coach",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "个人聊天教练：完整体系知识库、反馈与 MCP 接入",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/mcp.mjs",
    "start:restricted": "node src/mcp.mjs --http",
    "build": "node scripts/build.mjs",
    "start:beta": "node src/beta.mjs",
    "demo": "node src/beta.mjs --demo",
    "beta:admin": "node scripts/beta-admin.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:demo": "node scripts/verify-demo.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "playwright": "1.63.0"
  }
}
